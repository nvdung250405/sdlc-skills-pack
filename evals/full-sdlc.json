{
  "id": "eval-full-sdlc-01",
  "name": "Design and Implement Multi-Tenant Billing Subscriptions",
  "workflow": "workflows/full-sdlc.md",
  "task_description": "Architect and deliver an end-to-end multi-tenant subscription billing engine from customer opportunity framing to production release readiness.",
  "expected_stages": [
    "Opportunity Discovery & Framing",
    "Product Requirements Document (PRD)",
    "System Architecture & Interface Contracts",
    "Implementation Planning & Task Breakdown",
    "TDD Incremental Slices",
    "Pre-Release Checklist & Acceptance"
  ],
  "expected_skills": [
    "interview-me",
    "pm-product-spec",
    "software-architecture",
    "api-and-interface-design",
    "planning-and-task-breakdown",
    "test-driven-development",
    "verification-before-completion",
    "shipping-and-launch"
  ],
  "expected_artifacts": [
    {
      "alias": "brief",
      "canonical_path": "docs/discovery/billing-subscriptions/opportunity-brief.md",
      "must_contain": ["Target Users", "Opportunity Framing", "Core Hypothesis"]
    },
    {
      "alias": "prd",
      "canonical_path": "docs/prd.md",
      "must_contain": ["Goals", "Epics", "Non-Goals", "Risks"]
    },
    {
      "alias": "arch",
      "canonical_path": "docs/architecture.md",
      "must_contain": ["System Boundaries", "Component Breakdown", "Data Ownership"]
    },
    {
      "alias": "openapi",
      "canonical_path": "contracts/openapi.yaml",
      "must_contain": ["/v1/subscriptions", "openapi: 3.1"]
    },
    {
      "alias": "tasks",
      "canonical_path": "docs/features/billing-subscriptions/tasks.md",
      "must_contain": ["[ ]", "Task 1"]
    },
    {
      "alias": "checklist",
      "canonical_path": "docs/releases/release-checklist.md",
      "must_contain": ["Deployment Gates", "Rollback Trigger", "Smoke Test"]
    },
    {
      "alias": "completion",
      "canonical_path": "docs/features/billing-subscriptions/completion-report.md",
      "must_contain": ["Status", "Verification", "Limitations"]
    }
  ],
  "invariants": [
    "Architecture and OpenAPI contract must precede implementation",
    "One authoritative feature spec and task list",
    "All verification backed by executable command output"
  ]
}
