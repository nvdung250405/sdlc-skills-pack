  "precedence": {
    "using-sdlc-skills": "Only pack-level router. It classifies the work and selects a workflow; upstream skills do not install/activate a competing router by default.",
    "pm-user-story": "Owns the detailed Story/Acceptance Criteria section in the canonical feature spec. User story content must not be duplicated into another authoritative file.",
    "software-architecture": "Owns system architecture overview; ADRs, API contracts and detailed feature design are separate responsibilities.",
    "planning-and-task-breakdown": "Owns the final tasks list for a feature. Other workflow/skill content may inform the plan but must not create a competing task list.",
    "verification-before-completion": "Requires fresh observable evidence before making completion/pass claims; it does not replace acceptance criteria or independent review.",
    "systematic-debugging": "Default pack debugging skill. Stabilize/reproduce and identify root cause before changing code.",
    "webapp-testing": "Use Playwright-based tests when the environment supports it. Do not also invoke browser-testing-with-devtools unless the second tool provides distinct required evidence.",
    "database-design": "Provides schema design, indexing, and migration guidelines. Complements software-architecture by focusing on persistence tier.",
    "api-contract-testing": "Verifies wire-level provider/consumer schema contracts and backward compatibility using local fixtures; does not replace end-to-end web testing.",
    "auth-implementation-patterns": "Designs authentication tokens, session lifecycles, and RBAC/ABAC authorization boundaries; does not replace security code review.",
    "context-engineering": "Synthesizes AGENTS.md, establishes tool isolation boundaries, detects monorepo architecture, and enforces separation between short-term task state and long-term architecture invariants."
  },
