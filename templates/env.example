# ==============================================================================
# Canonical Artifact Template: Environment & Feature Flags Configuration
# Stage: 5. Implementation & Construction
# Primary Owner Skill: incremental-implementation, secrets-management
# Purpose: Explicit environment boundary template; committed without secrets.
# Verification Gate: Validation against schema or dotenv linter
# ==============================================================================

# -----------------------------------------------------------------------------
# Runtime & Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=info
APP_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Database & Cache (Connection strings placeholder only; DO NOT commit credentials)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/app_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication & Identity
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=replace-with-secure-32-char-random-key
AUTH_TOKEN_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# Feature Flags (Boolean 0/1 or string strategy)
# -----------------------------------------------------------------------------
FF_ENABLE_NEW_DASHBOARD=0
FF_ENABLE_ASYNC_EXPORT=1
FF_RATE_LIMIT_STRICT=0
